# Copy to .env (never commit .env)
ES_URL=https://elasticsearch.example:9200
KIBANA_URL=https://kibana.example:5601
# API key (base64 "id:key") - or use ES_USERNAME / ES_PASSWORD instead
ES_API_KEY=
#ES_USERNAME=
#ES_PASSWORD=
# CA bundle for self-signed / private CA clusters (recommended over INSECURE)
ES_CA_CERT=
#INSECURE=true
# Kibana space id (leave empty for the default space)
KIBANA_SPACE=
